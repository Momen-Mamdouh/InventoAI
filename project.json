{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "site-builder",
  "projectType": "application",
  "generators": {},
  "sourceRoot": "apps/site-builder/src",
  "prefix": "app",
  "implicitDependencies": [
    "spartan-ui",
    "spartan-stepper",
    "spartan-stepper-shared",
    "core",
    "shared"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "apps/site-builder/src/main.ts",
        "tsConfig": "apps/site-builder/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/site-builder/public"
          }
        ],
        "styles": ["apps/site-builder/src/styles.css"],
        "server": "apps/site-builder/src/main.server.ts",
        "outputMode": "server",
        "ssr": {
          "entry": "apps/site-builder/src/server.ts"
        },
        "outputPath": "dist/site-builder"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/site-builder/src/environments/environment.ts",
              "with": "apps/site-builder/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1MB",
              "maximumError": "2MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "site-builder:build:production"
        },
        "development": {
          "buildTarget": "site-builder:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4200,
        "proxyConfig": "apps/site-builder/proxy.conf.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/site-builder/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["apps/site-builder/src/**/*.ts", "apps/site-builder/src/**/*.html"]
      },
      "outputs": ["{options.outputFile}"]
    }
  },
  "tags": ["type:app", "scope:site-builder"]
}
