{
  "name": "invento-ai",
  "version": "0.0.0",
  "scripts": {
    "ng": "nx",
    "start": "nx serve site-builder -p 4200",
    "start:user-site": "nx serve user-site -p 4300",
    "start:owner-dashboard": "nx serve owner-dashboard -p 4400",
    "start:all": "nx run-many -t serve --projects=site-builder,user-site,owner-dashboard",
    "build": "nx build site-builder",
    "build:all": "nx run-many -t build",
    "test": "nx test site-builder",
    "test:all": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:names": "node scripts/check-project-names.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,scss,css,md}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@analogjs/router": "^2.6.3",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/platform-server": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/ssr": "^22.0.3",
    "@ng-icons/core": "^33.3.0",
    "@ng-icons/heroicons": "^33.3.0",
    "@ng-icons/lucide": "^33.3.0",
    "@ngxpert/hot-toast": "^6.3.0",
    "@spartan-ng/brain": "^0.0.1-alpha.720",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel": ">=8.0.0 <9.0.0",
    "embla-carousel-angular": "^22.0.0",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "ngx-cookie-service": "^22.0.0",
    "ngx-scrollbar": "^19.1.5",
    "ngx-sonner": "^3.1.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.0.3",
    "@angular-devkit/schematics": "^22.0.3",
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@schematics/angular": "^22.0.3",
    "@spartan-ng/cli": "^0.0.1-alpha.720",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.0.8",
    "ng-packagr": "~22.0.0",
    "nx": "23.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8"
  }
}
