# Frontend configuration -- the single source of truth for values that differ
# between environments. Copy it to `.env` and edit:
#
#   cp env.example .env && npm run generate:env
#
# The start:* and build scripts run the generator for you, so in day-to-day work
# you only ever edit `.env`.
#
# NOTHING HERE IS SECRET. Every value below is compiled into the browser bundle
# and is readable by anyone who loads the site. This file buys configurability,
# not confidentiality -- never put an API key, token or password in it. Real
# secrets belong to the backend only.
#
# This file is not just documentation: the generator READS it as its lowest
# precedence layer, so the values below are the effective defaults. There is
# exactly one place a value is written, and the documented default cannot drift
# from the real one. A key the generator needs but that is missing here is a
# hard error, not a silent fallback.
#
# Precedence, highest first:
#   1. real environment variables (Vercel project settings, CI)
#   2. .env, if you created one
#   3. this file
#
# When deploying, set the production keys as host environment variables rather
# than committing them -- they outrank .env, so no code change is needed to
# repoint an app. The _DEV keys are only used for local development.
#
# Omitting a key entirely falls through to the default. Setting a key to an
# empty value is meaningful and is NOT the same as omitting it (see
# OWNER_DASHBOARD_API_URL_DEV below).

# --- Production -------------------------------------------------------------

SITE_BUILDER_API_URL=https://invento-api-ashy.vercel.app
SITE_BUILDER_DASHBOARD_URL=https://invento-ai.vercel.app/home

# Optional. Left blank, ApiConfig derives it from `production`
# (libs/site-builder/data-access-preview/src/lib/api-config.ts).
SITE_BUILDER_LOGIN_URL=

USER_SITE_API_URL=https://invento-api-ashy.vercel.app

OWNER_DASHBOARD_API_URL=https://invento-api-ashy.vercel.app
OWNER_DASHBOARD_SITE_BUILDER_URL=https://test-site-builder.vercel.app

# --- Development ------------------------------------------------------------

# One switch repoints all three apps between the local backend and production.
DEV_API_TARGET=http://localhost:3000

SITE_BUILDER_DASHBOARD_URL_DEV=http://localhost:4400/home
SITE_BUILDER_LOGIN_URL_DEV=

OWNER_DASHBOARD_SITE_BUILDER_URL_DEV=http://localhost:4200
