{
  "name": "invento-feature-faq",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/invento/feature-faq/src",
  "prefix": "lib",
  "tags": [
    "scope:invento",
    "type:feature"
  ],
  "projectType": "library",
  "// targets": "to see all targets run: nx show project feature-faq --web",
  "targets": {
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/invento/feature-faq/**/*.ts",
          "libs/invento/feature-faq/**/*.html"
        ]
      }
    }
  }
}
