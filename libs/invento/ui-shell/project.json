{
  "name": "invento-ui-shell",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/invento/ui-shell/src",
  "prefix": "lib",
  "tags": [
    "scope:invento",
    "type:feature"
  ],
  "projectType": "library",
  "// targets": "to see all targets run: nx show project ui-shell --web",
  "targets": {
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/invento/ui-shell/**/*.ts",
          "libs/invento/ui-shell/**/*.html"
        ]
      }
    }
  }
}
