{
  "name": "site-builder-feature-builder",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/site-builder/feature-builder/src",
  "prefix": "lib",
  "tags": [
    "scope:site-builder",
    "type:feature"
  ],
  "projectType": "library",
  "// targets": "to see all targets run: nx show project feature-builder --web",
  "targets": {
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/site-builder/feature-builder/**/*.ts",
          "libs/site-builder/feature-builder/**/*.html"
        ]
      }
    }
  }
}
