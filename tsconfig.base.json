      "@spartan/helm/select": ["./libs/ui/select/src/index.ts"],
      "@spartan/helm/table": ["./libs/ui/table/src/index.ts"],
      "@spartan/helm/field": ["./libs/ui/field/src/index.ts"],
      "@spartan/helm/switch": ["./libs/ui/switch/src/index.ts"],
      "@spartan/helm/spinner": ["./libs/ui/spinner/src/index.ts"],
