{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default"],
      "options": {
        "maxWarnings": 0
      }
    },
    "@angular/build:application": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["production", "^production"],
      "_comment": "Apps consume libs/* from SOURCE via tsconfig paths, so they must NOT trigger ng-packagr packaging of libs. Packaging is currently broken by design: each ui lib gets its own rootDir but they share source across libs (TS6059). See plan 05 audit item C6."
    },
    "@nx/angular:ng-packagr-lite": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "namedInputs": {
    "sharedGlobals": [],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"]
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "linter": "none",
      "style": "css",
      "unitTestRunner": "none"
    },
    "@nx/angular:library": {
      "linter": "none",
      "unitTestRunner": "none"
    },
    "@nx/angular:component": {
      "style": "css"
    }
  },
  "analytics": false
}
